{
  "name": "junkyard-genius",
  "version": "1.0.0",
  "description": "<p align=\"center\">   <h1 align=\"center\">Junkyard Genius</h1>   <p align=\"center\"><strong>338 insane DIY builds from salvaged appliances, e-waste, chemicals, and junk.</strong></p>   <p align=\"center\">     <img src=\"https://img.shields.io/badge/builds-338-orange?style=for-the-badge\" alt=\"338 Builds\" />     <img src=\"https://img.shields.io/badge/categories-33-blue?style=for-the-badge\" alt=\"33 Categories\" />     <img src=\"https://img.shields.io/github/license/rbrents3000/junkyard-genius?style=for-the-badge\" alt=\"License\" />     <img src=\"https://img.shields.io/github/stars/rbrents3000/junkyard-genius?style=for-the-badge\" alt=\"Stars\" />   </p>   <p align=\"center\">     <img src=\"images/hero-banner.jpg\" alt=\"Junkyard Genius — salvaged parts, infinite possibilities\" width=\"800\" />   </p> </p>",
  "main": "sw.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "css": "npx @tailwindcss/cli -i ./src/styles/main.css -o ./_site/style.css --minify",
    "css:watch": "npx @tailwindcss/cli -i ./src/styles/main.css -o ./_site/style.css --watch",
    "build": "npm run css && eleventy",
    "dev": "concurrently \"npm run css:watch\" \"eleventy --serve\"",
    "test": "npx playwright test",
    "test:live": "PLAYWRIGHT_BASE_URL=https://junkyard.build npx playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbrents3000/junkyard-genius.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rbrents3000/junkyard-genius/issues"
  },
  "homepage": "https://github.com/rbrents3000/junkyard-genius#readme",
  "dependencies": {
    "@11ty/eleventy": "^3.1.5",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/postcss": "^4.2.2",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2"
  }
}
